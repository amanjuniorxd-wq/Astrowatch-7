# Astrowatch Online -- environment configuration template.
# Copy this file to .env for local development (.env is gitignored -- never commit
# real secrets). In production (Render etc.), set these as platform environment
# variables instead of a checked-in file.

# --- OpenAI (AI intelligence/orchestration/synthesis layer) ---------------
# Required for /api/predict, /api/agent/run, /api/random-prediction,
# /api/current-event. Astrowatch's core calculation endpoints (POST /api/chart)
# work fully without these -- the AI layer degrades gracefully if unset.
OPENAI_API_KEY=
# Configurable model -- do not assume a permanently fixed name. Defaults to
# gpt-4o-mini in code if this is left blank; set to whatever current model you
# want (e.g. gpt-4o, gpt-4.1, o4-mini, etc.).
OPENAI_MODEL=gpt-4o-mini
# Optional: cap AI-generated output length (characters) to control cost.
OPENAI_MAX_OUTPUT_TOKENS=1200

# --- Server ------------------------------------------------------------
# Cloud platforms (Render etc.) inject PORT automatically -- leave unset locally
# to use the default (8420), or override for local testing.
PORT=8420
# HOST defaults to 0.0.0.0 (required to be reachable in a container). Override to
# 127.0.0.1 only for a strictly localhost-only local dev setup.
HOST=0.0.0.0

# --- Autonomous prediction system ---------------------------------------
PREDICTIONS_PER_DAY=2
# Comma-separated 24h UTC hours the scheduler is allowed to post within, e.g.
# "09,18" -- if unset, the scheduler spreads PREDICTIONS_PER_DAY evenly across
# the day starting at 00:00 UTC.
PREDICTION_POSTING_WINDOWS_UTC=

# --- X (Twitter) publishing -- OPTIONAL, disabled by default ------------
# The whole system works with X_ENABLED=false (or unset). Only set the
# credentials below if you explicitly want to enable auto-publishing.
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
